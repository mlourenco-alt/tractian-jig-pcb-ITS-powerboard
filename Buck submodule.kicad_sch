			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "b43f6df4-c76c-439d-80f1-1d64feabcf00")
	)
