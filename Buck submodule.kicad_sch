		(uuid "6adc4e38-db5f-4875-a73c-3016d1284cc2")
	)
	(text "\"Connect to GND to disable\nspread spectrum\""
		(exclude_from_sim no)
		(at 51.816 274.828 90)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left)
		)
		(uuid "99b19f5a-4a38-45e8-91fb-afc139e44eb5")
	)
	(text "\"These pins (AGND) must be connected to PGND\""
		(exclude_from_sim no)
		(at 128.524 141.478 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
		)
		(uuid "e0cff6c6-a960-408c-aa3c-c9f5d41e758e")
	)
	(text_box "\"If improved EMI is not required, connect RBOOT to CBOOT to short the internal resistor,thus resulting in highest efficiency.\n\nIf lower EMI is required, connect a resistor from 100 Ω - 500 Ω\""
		(exclude_from_sim no)
		(at 109.22 196.85 0)
		(size 38.1 16.51)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "5c362a76-6ec7-45b7-8d51-0684473d3fb8")
	)
	(text_box "\"The TPSM63610 requires a minimum of two 10-µF ceramic input capacitors, preferably with X7R or X7S\ndielectric and in 1206 or 1210 footprint\""
		(exclude_from_sim no)
		(at 43.815 78.74 0)
		(size 33.02 16.51)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "73512ed7-c9d6-40c9-943d-c928164ff56d")
	)
	(text_box "A typical value for this\nsupply bypass capacitor\nis 0.1µF"
		(exclude_from_sim no)
		(at 468.376 106.426 0)
		(size 27.432 8.382)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "86c8bc3d-a219-422d-be3e-6e5260233b5d")
	)
	(text_box "\"In general, filtering the device input\nis only necessary if there are transients\nat exact harmonics of the 500kHz\n(±0.5% max) sampling rate (greater than 1MHz)\""
		(exclude_from_sim no)
		(at 497.078 252.222 0)
		(size 39.37 13.97)
		(margins 0.9525 0.9525 0.9525 0.9525)
