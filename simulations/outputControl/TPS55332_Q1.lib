.SUBCKT TPS55332 EN  SW VIN PGND VREG  RST RT RST_TH RSlew COMP GND1 GND2 GND3 Cdly VSENSE SS

R_XTOP_R10         0 SYNC  100M  
X_XTOP_SS_S1    XTOP_SDWN 0 SS 0 START_UP_XTOP_SS_S1 
V_XTOP_SS_V1         XTOP_SS_N00223 0 5Vdc
I_XTOP_SS_I1         XTOP_SS_N00223 SS DC 40uAdc  
X_XTOP_SS_D1         SS XTOP_SS_N00223 d_d1
E_XTOP_SS_ABM11         XTOP_VREF 0 VALUE { IF(V(SS)<2.5, V(SS), 
+  V(XTOP_SS_N01607))    }
V_XTOP_SS_V2         XTOP_SS_N01607 0 2.5Vdc
X_XTOP_URST_D63         CDLY XTOP_URST_N1 d_d1
X_XTOP_URST_U142         XTOP_URST_N16785498 XTOP_N17006112 BUF_DELAY_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY=20u
X_XTOP_URST_U140         CDLY XTOP_URST_N16784992 INV_BASIC_GEN PARAMS: VDD=1
+  VSS=0 VTHRESH=500E-3
X_XTOP_URST_U141         XTOP_URST_N16784992 XTOP_URST_N16785498 INV_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
R_XTOP_URST_R4         CDLY XTOP_URST_N1  1.45e6  
X_XTOP_URST_U139         XTOP_N17004094 XTOP_URST_N1 BUF_DELAY_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY=1f
C_XTOP_EN_C1         0 XTOP_SDWN  1n  
R_XTOP_EN_R1         XTOP_EN_EN_NOFILT XTOP_SDWN  1  
E_XTOP_EN_ABM173         XTOP_EN_EN_NOFILT 0 VALUE { {IF(V(EN) < 0.7,1,0)}    }
E_XTOP_ABM1         XTOP_RAMP_SHIFTED 0 VALUE { (V(XTOP_RAMP) *1)+1    }
X_XTOP_S3    SYNC 0 XTOP_N16767984 XTOP_DETECT_V TPS55332Q1_TOP_XTOP_S3 
X_XTOP_U41         XTOP_USE_EXT_CLK XTOP_N16770236 INV_BASIC_GEN PARAMS: VDD=1
+  VSS=0 VTHRESH=500E-3
V_XTOP_V5         XTOP_HYST 0 0
X_XTOP_U39         XTOP_RAMP_SHIFTED COMP XTOP_HYST XTOP_VCONTROL
+  COMPHYS_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=0.5
V_XTOP_U_Osc_V49         XTOP_U_Osc_N16723147 0 1.6
X_XTOP_U_Osc_S28    XTOP_U_Osc_N16723195 0 XTOP_RAMP 0
+  Oscillator_XTOP_U_Osc_S28 
V_XTOP_U_Osc_V50         XTOP_U_Osc_N16723191 0 5
X_XTOP_U_Osc_U137         XTOP_SDWN XTOP_U_Osc_N16723141 XTOP_U_Osc_N16723195
+  OR2_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
C_XTOP_U_Osc_C80         XTOP_RAMP 0  5.1p  
V_XTOP_U_Osc_V51         XTOP_U_Osc_N16723175 0 1
X_XTOP_U_Osc_U132         XTOP_RAMP XTOP_U_Osc_N16723147 XTOP_SYSCLK
+  COMP_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=0.5
X_XTOP_U_Osc_U136         XTOP_SYSCLK XTOP_U_Osc_N16723141 BUF_DELAY_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY=120n
X_XTOP_U_Osc_F4    RT XTOP_U_Osc_N16723175 XTOP_U_Osc_N16723191 XTOP_RAMP
+  Oscillator_XTOP_U_Osc_F4 
X_XTOP_U_Osc_D12         XTOP_RAMP XTOP_U_Osc_N16723191 d_d1
X_XTOP_U_Osc_D13         0 XTOP_RAMP d_d1
X_XTOP_S2    XTOP_USE_EXT_CLK 0 SYNC XTOP_CLK TPS55332Q1_TOP_XTOP_S2 
R_XTOP_R1         GND 0  1m  
X_XTOP_U40         XTOP_N17004056 RST_TH XTOP_N17004074 XTOP_N17004094
+  COMPHYS_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=0.5
C_XTOP_C138         0 XTOP_DETECT_V  90n IC=0 
V_XTOP_V6         XTOP_N17004074 0 0
X_XTOP_S4    XTOP_N16770236 0 XTOP_SYSCLK XTOP_CLK TPS55332Q1_TOP_XTOP_S4 
V_XTOP_V7         XTOP_N17004056 0 0.8
V_XTOP_V10         XTOP_N16768130 0 60m
X_XTOP_S1    XTOP_N17006112 0 RST 0 TPS55332Q1_TOP_XTOP_S1 
R_XTOP_R9         0 XTOP_DETECT_V  1k  
R_XTOP_R2         GND 0  1m  
R_XTOP_R5         GND 0  1m  
X_XTOP_U42         XTOP_DETECT_V XTOP_N16768130 XTOP_N16768220 XTOP_USE_EXT_CLK
+  COMPHYS_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=0.5
X_XTOP_U50         XTOP_CURRENT_LIM XTOP_VCONTROL XTOP_CLRZ NOR2_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
V_XTOP_V11         XTOP_N16768220 0 0
X_XTOP_U7_D1T         XTOP_U7_N16489522 XTOP_U7_INDELAYED1 d_d1
X_XTOP_U7_U823         XTOP_U7_N16497188 XTOP_PWM_OUT XTOP_U7_N16489522
+  AND2_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
X_XTOP_U7_U822         XTOP_PWM_OUT XTOP_U7_N16497188 INV_DELAY_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY=15n
C_XTOP_U7_C172         0 XTOP_U7_INDELAYED1  10p  
X_XTOP_U7_U824         XTOP_U7_N16489522 XTOP_U7_INDELAYED1 XTOP_PWM_OUT
+  XTOP_PWM_FINAL OR3_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
R_XTOP_U7_R272         XTOP_U7_N16489522 XTOP_U7_INDELAYED1  1.353k  
*******C_XTOP_UEA_C14         COMP XTOP_UEA_N16839131  3.3n  TC=0,0 
*******C_XTOP_UEA_C15         COMP VSENSE  12p  TC=0,0 
********R_XTOP_UEA_R5         XTOP_UEA_N16839131 VSENSE  10k TC=0,0
X_XTOP_UEA_U8         XTOP_UEA_N16791518 COMP d_d
X_XTOP_UEA_U11         COMP XTOP_UEA_N16791505 d_d
V_XTOP_UEA_V13         XTOP_UEA_N16791505 0 2.61
V_XTOP_UEA_V14         XTOP_UEA_N16791518 0 1v
X_XTOP_UEA_S6    XTOP_UEA_N16791571 0 COMP 0 EA_XTOP_UEA_S6 
X_XTOP_UEA_U24         EN XTOP_UEA_N16791571 INV_BASIC_GEN PARAMS: VDD=1 VSS=0
+  VTHRESH=500E-3
R_XTOP_UEA_R14         0 COMP  100meg TC=0,0 
G_XTOP_UEA_G1         0 COMP XTOP_VREF VSENSE 1m
 
X_XTOP_D3         XTOP_N16767984 SYNC d_d1
I_XTOP_I3         SYNC XTOP_N16767984 DC 1mAdc  
X_XTOP_U51         XTOP_SYSCLK XTOP_N16998676 INV_BASIC_GEN PARAMS: VDD=1 VSS=0
+  VTHRESH=500E-3
V_XTOP_V8         XTOP_VDD 0 1
X_XTOP_u1u_U99         XTOP_SYSCLK XTOP_u1u_N16790444 INV_BASIC_GEN PARAMS:
+  VDD=1 VSS=0 VTHRESH=500E-3
X_XTOP_u1u_U25         XTOP_ISW XTOP_u1u_N16786487 XTOP_u1u_OC COMP_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=0.5
C_XTOP_u1u_C172         0 XTOP_u1u_OC_DELAYED  10p  
R_XTOP_u1u_R272         XTOP_u1u_OC XTOP_u1u_OC_DELAYED  2k  
V_XTOP_u1u_V4         XTOP_u1u_ONE 0 1
V_XTOP_u1u_V5         XTOP_u1u_N16786487 0 5.7
X_XTOP_u1u_D1T         XTOP_u1u_OC_DELAYED XTOP_u1u_OC d_d1
X_XTOP_u1u_U98         XTOP_u1u_N16790444 XTOP_u1u_N16782883
+  BUF_DELAY_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=0.5 DELAY=15n
X_XTOP_u1u_U100         N16796727 N16796824 XTOP_CURRENT_LIM XTOP_u1u_ONE
+  XTOP_SYSCLK XTOP_u1u_ONE DFFSBRB_NODELAY PARAMS:  VDD=1 VSS=0 VTHRESH=0.5
X_XTOP_u1u_U96         XTOP_u1u_N16782883 XTOP_u1u_OC_DELAYED XTOP_CURRENT_LIM
+  AND2_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
X_XTOP_U_Driver1_U613         XTOP_SDWN XTOP_U_Driver1_N7375083 INV_BASIC_GEN
+  PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
X_XTOP_U_Driver1_H1    XTOP_U_Driver1_N7375243 GND XTOP_ISW 0
+  Driver_XTOP_U_Driver1_H1 
X_XTOP_U_Driver1_S30    XTOP_U_Driver1_PWM 0 SW XTOP_U_Driver1_N7375243
+  Driver_XTOP_U_Driver1_S30 
X_XTOP_U_Driver1_U604         XTOP_U_Driver1_N7375083 XTOP_PWM_FINAL
+  XTOP_U_Driver1_PWM AND2_BASIC_GEN PARAMS: VDD=1 VSS=0 VTHRESH=500E-3
X_XTOP_U_Driver1_D1         XTOP_U_Driver1_N7375243 SW d_d1
X_XTOP_U100         XTOP_PWM_OUT N16863962 XTOP_N16998676 XTOP_VDD XTOP_CLRZ
+  XTOP_VDD DFFSBRB_NODELAY PARAMS:  VDD=1 VSS=0 VTHRESH=0.5
.IC         V(XTOP_RAMP )=0

.ends TPS55332

.subckt START_UP_XTOP_SS_S1 1 2 3 4  
S_XTOP_SS_S1         3 4 1 2 _XTOP_SS_S1
RS_XTOP_SS_S1         1 2 1G
.MODEL         _XTOP_SS_S1 VSWITCH Roff=1e6 Ron=1.0 Voff=0.2V Von=0.8V
.ends START_UP_XTOP_SS_S1

.subckt TPS55332Q1_TOP_XTOP_S3 1 2 3 4  
