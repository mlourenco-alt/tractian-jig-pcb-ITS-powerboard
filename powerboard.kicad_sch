	(text "\"DO/DI - Wired together and connected to SDA pin of 24LC256 for bidirectional data transfer. DO set as\noutput pin to transfer serial data or address from FT2232H to 24LC256 device. DI set as input pin to\nreceive serial data input pin from 24LC256 device to FT2232H. Requires a pull-up resistor to VCC (typical\n10 KΩ for 100 kHz and 2 KΩ for 400 kHz). \""
		(exclude_from_sim no)
		(at 141.224 321.056 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left)
			(href "https://ftdichip.com/Documents/AppNotes/AN_113_FTDI_Hi_Speed_USB_To_I2C_Example.pdf#page=6")
		)
		(uuid "1169fa2c-d25c-417f-9bd8-666a2a392133")
	)
	(text "Start with 1k to try run the Bus at\n1Mhz."
		(exclude_from_sim no)
		(at 140.97 299.72 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "681936ac-6de3-4ada-8fec-9c432039249b")
	)
	(text "Schottky diode so the DO can only pull\nthe SDA low. Replace for 0R if this\ngoes south"
		(exclude_from_sim no)
		(at 57.658 321.056 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify right)
		)
		(uuid "780f3b26-b203-4484-9b2a-5424a8da2bc7")
	)
