	(text "\"DO/DI - Wired together and connected to SDA pin of\n]24LC256 for bidirectional data transfer. DO set as\noutput pin to transfer serial data or address from\nFT2232H to 24LC256 device. DI set as input pin to\nreceive serial data input pin from 24LC256 device to\nFT2232H. Requires a pull-up resistor to VCC (typical\n10 KΩ for 100 kHz and 2 KΩ for 400 kHz). \""
		(exclude_from_sim no)
		(at 127.508 281.178 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left)
			(href "https://ftdichip.com/Documents/AppNotes/AN_113_FTDI_Hi_Speed_USB_To_I2C_Example.pdf#page=6")
		)
		(uuid "1169fa2c-d25c-417f-9bd8-666a2a392133")
	)
	(text "Cb1 = Trace capacitance 1\nCxtal = 6pF\nCs1 = Cb1 + Cxtal\n\nCb2 = Trace capacitance 2\nCxtal = 6pF\nCs2 = Cb2 + Cxtal\n\nCl = 18pF\nC0 = 3pF\n"
		(exclude_from_sim no)
		(at 642.62 41.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "489b2347-6f23-4f60-980e-63bb7187a3e2")
	)
	(text "Start with 1k to try run the Bus at\n1Mhz."
		(exclude_from_sim no)
		(at 148.59 254 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "681936ac-6de3-4ada-8fec-9c432039249b")
	)
	(text "Schottky diode so the DO can only pull\nthe SDA low. Replace for 0R if this\ngoes south"
		(exclude_from_sim no)
		(at 65.278 275.336 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify right)
		)
		(uuid "780f3b26-b203-4484-9b2a-5424a8da2bc7")
	)
	(text "Calculate the trace capacitance\nand replace the 18pF for a more\nappropriate value"
		(exclude_from_sim no)
		(at 539.75 36.068 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "968b59a1-a0f2-487b-b67d-264dea52dcc5")
	)
	(text "Test using the FT4233 GPIOs to control and read states of the INA scales.\nBut use it as a redundant feature, still maintain the IO/Expanders as main\ndrivers"
		(exclude_from_sim no)
		(at 47.752 358.648 0)
		(effects
